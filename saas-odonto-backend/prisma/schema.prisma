datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Tenant / Clinic
// Tenant / Clinic - ATUALIZADO COM O MOTOR DE RECORRÊNCIA
model Tenant {
  id               BigInt                 @id @default(autoincrement())
  name             String                 @db.VarChar(200)
  slug             String                 @unique @db.VarChar(100)
  domain           String?                @db.VarChar(255)
  subdomain        String?                @db.VarChar(100)
  plan             String                 @default("starter") @db.VarChar(50)
  status           String                 @default("active") @db.VarChar(30)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at")
  clinicSites      ClinicSite[]
  patients         Patient[]
  professionals    Professional[]
  users            User[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  financialTrans   FinancialTransaction[]

  financialRecur   FinancialRecurrence[]  
  dentalProcedures DentalProcedure[]
  anamneses        Anamnese[]
  professionalSchedules   ProfessionalSchedule[]
  scheduleExceptions      ScheduleException[]
  professionalProcedures  ProfessionalProcedure[]

  @@map("tenants")
}


// System Users (Authentication)
model User {
  id            BigInt         @id @default(autoincrement())
  tenantId      BigInt         @map("tenant_id")
  name          String         @db.VarChar(200)
  email         String         @db.VarChar(255)
  password      String         @db.VarChar(255)
  role          String         @db.VarChar(50)
  active        Boolean        @default(true)
  lastLogin     DateTime?      @map("last_login")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  professionals Professional[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email], name: "uk_users_email")
  @@map("users")
}

// Dentists / Professionals
model Professional {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  userId    BigInt?  @map("user_id")
  name      String   @db.VarChar(200)
  cro       String?  @db.VarChar(50) // Registro do Conselho Regional de Odontologia
  specialty String?  @db.VarChar(100) // ex: "Ortodontia", "Endodontia"
  active    Boolean  @default(true)
  bufferTime  Int      @default(10) @map("buffer_time") // Tempo de higienização em minutos
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relacionamentos
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  schedules   ProfessionalSchedule[]
  exceptions  ScheduleException[]
  procedures  ProfessionalProcedure[]

  @@map("professionals")
}

// Clinic Custom Landing Page
model ClinicSite {
  id          BigInt  @id @default(autoincrement())
  tenantId    BigInt  @unique @map("tenant_id") // 🚀 Adicionado @unique (1 site por clínica)
  title       String  @db.VarChar(255)
  description String? @db.Text
  logo        String? @db.VarChar(500)
  phone       String? @db.VarChar(30)
  whatsapp    String? @db.VarChar(30)

  //Branding & Custom Palette (Apple / High-Tech Style Baseline)
  primaryColor    String @default("#0F172A") @map("primary_color") @db.VarChar(7) // Deep Obsidian
  accentColor     String @default("#10B981") @map("accent_color") @db.VarChar(7) // Mint Clean
  backgroundColor String @default("#F8FAFC") @map("background_color") @db.VarChar(7) // Soft Platinum
  theme           String @default("light") @db.VarChar(50) // light or dark

  // 🚀 NOVOS CAMPOS PARA CONTROLE DE PUBLICAÇÃO
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("clinic_sites")
}

// Patients
model Patient {
  id             BigInt                 @id @default(autoincrement())
  tenantId       BigInt                 @map("tenant_id")
  name           String                 @db.VarChar(200)
  cpf            String?                @db.VarChar(14)
  whatsapp       String?                @db.VarChar(30)
  createdAt      DateTime               @default(now()) @map("created_at")
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  financialTrans FinancialTransaction[]

  anamnese Anamnese?

  @@map("patients")
}

// Appointments / Agenda
model Appointment {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  patientId      BigInt   @map("patient_id")
  professionalId BigInt   @map("professional_id")
  startAt        DateTime @map("start_at") @db.Timestamp()
  endAt          DateTime @map("end_at") @db.Timestamp()
  type           String?  @db.VarChar(100)
  status         String   @default("scheduled") // scheduled, waiting, in_attendance, completed)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // Relacionamentos
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade) // 🚀 Nova amarração!

  @@map("appointments")
}

// Medical Records / Clinical Evolution (Updated with Procedure Relation)
model MedicalRecord {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  patientId      BigInt   @map("patient_id")
  professionalId BigInt   @map("professional_id")
  procedureId    BigInt?  @map("procedure_id")
  description    String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // Relacionamentos
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure    DentalProcedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  professional Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade) // 🚀 Nova amarração!

  @@map("medical_records")
}

// Catálogo de procedimentos e precificação
model DentalProcedure {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @map("tenant_id")
  name         String   @db.VarChar(150) // ex: "Clareamento Caseiro", "Profilaxia (Limpeza)"
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2) // Preço sugerido do procedimento
  estimatedMin Int      @default(60) @map("estimated_min") // Tempo estimado de cadeira em minutos
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  medicalRecords MedicalRecord[]
  professionals ProfessionalProcedure[]

  @@map("dental_procedures")
}

// Cash Flow / Financial Transactions - EXPANDIDO PARA RECORRÊNCIA E PARCELAMENTO
model FinancialTransaction {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @map("tenant_id")
  patientId     BigInt?   @map("patient_id")
  recurrenceId  BigInt?   @map("recurrence_id") // 🚀 ADICIONADO: Conexão com o motor de recorrência
  treatmentId   BigInt?   @map("treatment_id")  // 🚀 ADICIONADO: Conexão com o parcelamento de tratamentos

  description   String    @db.VarChar(255)
  amount        Decimal   @db.Decimal(10, 2)
  type          String    @db.VarChar(10) // "INCOME" or "EXPENSE"
  status        String    @default("pending") @db.VarChar(30) // "paid", "pending", "overdue", "cancelled"
  category      String    @default("outros") @db.VarChar(50)  // 🚀 ADICIONADO: Organização do DRE (Ex: material, aluguel, salários)
  
  installment       Int?    @default(1) // 🚀 ADICIONADO: Parcela atual (Ex: 1, 2, 3...)
  totalInstallments Int?    @default(1) @map("total_installments") // 🚀 ADICIONADO: Total de parcelas (Ex: 12)

  dueDate       DateTime  @map("due_date") @db.Date
  paymentDate   DateTime? @map("payment_date") @db.Date
  paymentMethod String?   @map("payment_method") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient    Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  recurrence FinancialRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: Cascade) // 🚀 ADICIONADO: Relacionamento estruturado

  @@map("financial_transactions")
}


model FinancialRecurrence {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt    @map("tenant_id")
  description     String    @db.VarChar(255)
  amount          Decimal   @db.Decimal(10, 2)
  type            String    @db.VarChar(10) // "INCOME" or "EXPENSE"
  category        String    @db.VarChar(50)
  frequency       String    @default("monthly") @db.VarChar(30) // "monthly", "weekly", "yearly"
  dayOfMonth      Int       @default(5) @map("day_of_month") // Dia fixo de vencimento do carnê/despesa
  
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date // Se for nulo, roda por tempo indeterminado
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions    FinancialTransaction[] 

  @@map("financial_recurrences")
}


model Anamnese {
  id                   BigInt   @id @default(autoincrement())
  tenantId             BigInt   @map("tenant_id")
  patientId            BigInt   @unique @map("patient_id") 
  hasAllergy           Boolean  @default(false) @map("has_allergy")
  allergyDetails       String   @default("Nenhuma") @map("allergy_details") @db.Text
  hasHeartDisease      Boolean  @default(false) @map("has_heart_disease")
  isHypertensive       Boolean  @default(false) @map("is_hypertensive")
  continuousMedication String   @default("Nenhum") @map("continuous_medication") @db.Text
  bleedingHistory      Boolean  @default(false) @map("bleeding_history")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("anamnese")
}

// Mensagens de Contato (Formulário da Landing Page)
model ContactMessage {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(255)
  message   String   @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45) // Para auditoria de segurança (IPv4 ou IPv6)
  status    String   @default("pending") @db.VarChar(50) // pending, read, replied
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model ProfessionalSchedule {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  professionalId BigInt   @map("professional_id")
  
  dayOfWeek      Int      @map("day_of_week") // 0=Domingo, 1=Segunda... 6=Sábado
  startTime      String   @map("start_time") @db.VarChar(5) // "09:00"
  endTime        String   @map("end_time") @db.VarChar(5)   // "18:00"
  breakStart     String?  @map("break_start") @db.VarChar(5) // "12:00"
  breakEnd       String?  @map("break_end") @db.VarChar(5)   // "13:00"
  
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
  @@map("professional_schedules")
}

// Exceções (Férias, folgas ou horários especiais)
model ScheduleException {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  professionalId BigInt   @map("professional_id")
  
  date           DateTime @db.Date // O dia exato da exceção
  isAvailable    Boolean  @map("is_available") // false = Férias/Folga | true = Trabalho especial
  startTime      String?  @map("start_time") @db.VarChar(5) 
  endTime        String?  @map("end_time") @db.VarChar(5)   
  reason         String?  @db.VarChar(255) 
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("schedule_exceptions")
}

// Ligação Profissional x Procedimento
model ProfessionalProcedure {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  professionalId BigInt   @map("professional_id")
  procedureId    BigInt   @map("procedure_id")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  procedure    DentalProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([professionalId, procedureId]) // Evita duplicar a mesma ligação
  @@map("professional_procedures")
}
